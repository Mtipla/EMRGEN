# Copiar a .env.android-lan.local EN LA RAÍZ DEL MONOREPO (archivo ignorado).
# Sustituir REEMPLAZAR_IP_LAN por la IPv4 Wi-Fi/Ethernet del PC accesible al teléfono.
# Modalidad principal: NestJS local 3000 + FastAPI 8000. Docker NestJS usa 3001.
VITE_API_URL=http://REEMPLAZAR_IP_LAN:3000
VITE_INTERNAL_API_URL=http://REEMPLAZAR_IP_LAN:8000
VITE_DEPLOYMENT_ID=local
# android:prepare comprueba la conexión real de WhatsApp en ESTA instancia.
# Configuración pública de Firebase: se hereda del .env raíz existente.
# No poner JWT_SECRET, MEDICAL_DATA_KEYS ni credenciales de servidor aquí.
