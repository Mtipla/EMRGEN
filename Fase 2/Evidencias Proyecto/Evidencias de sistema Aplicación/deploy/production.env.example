# SERVIDOR: plantilla privada para docker-compose.production.yml; no es configuración Vite.
# Sustituir todos los marcadores; no sobrescribir ningún archivo operativo.
BACKEND_IMAGE=<INSERT_REVIEWED_BACKEND_IMAGE_DIGEST>
INTERNAL_API_IMAGE=<INSERT_REVIEWED_INTERNAL_API_IMAGE_DIGEST>
EMERGEN_DEPLOYMENT_ID=<INSERT_DEPLOYMENT_ID>
DB_BOOTSTRAP_USER=<INSERT_BOOTSTRAP_ROLE>
DB_BOOTSTRAP_PASSWORD=<INSERT_PRIVATE_BOOTSTRAP_PASSWORD>
DB_NAME=<INSERT_DATABASE_NAME>
APP_DB_USER=<INSERT_PROVISIONED_APPLICATION_ROLE>
APP_DB_PASSWORD=<INSERT_PRIVATE_APPLICATION_PASSWORD>
# Declarar verify-full y CA válida, o política disable aprobada explícitamente.
DB_SSLMODE=<INSERT_APPROVED_SSLMODE>
CA_DIRECTORY=<INSERT_ABSOLUTE_DIRECTORY_WITH_PUBLIC_CA_ONLY>
DB_SSL_CA_FILE=<INSERT_CONTAINER_CA_PATH_IF_VERIFY_FULL>
PRODUCTION_DB_VOLUME=<INSERT_CONFIRMED_DESTINATION_VOLUME>
PRODUCTION_WHATSAPP_VOLUME=<INSERT_CONFIRMED_PERSISTENT_SENDER_VOLUME>
JWT_SECRET=<INSERT_SHARED_PRIVATE_SIGNING_SECRET>
JWT_SESSION_HOURS=2
# Traslado con datos: conservar todas las claves médicas existentes, nunca generar reemplazo.
MEDICAL_DATA_KEYS=<INSERT_PRESERVED_PRIVATE_MEDICAL_KEYRING>
CORS_ORIGINS=<INSERT_EXACT_PUBLIC_HTTPS_AND_NATIVE_ORIGINS>
TRUSTED_PROXY_CIDRS=
FORWARDED_ALLOW_IPS=
JSREPORT_URL=<INSERT_MANAGED_HTTPS_REPORT_SERVICE>
JSREPORT_USERNAME=<INSERT_PRIVATE_REPORT_IDENTITY>
JSREPORT_PASSWORD=<INSERT_PRIVATE_REPORT_CREDENTIAL>
WHATSAPP_SENDER_PHONE=<INSERT_PRIVATE_SENDER_PHONE>
FIREBASE_PROJECT_ID=<INSERT_FIREBASE_PROJECT>
GOOGLE_MAPS_API_KEY=<INSERT_RESTRICTED_SERVER_MAPS_KEY>
PAYPAL_MODE=<INSERT_EXPLICIT_SANDBOX_OR_LIVE>
PAYPAL_CLIENT_ID=<INSERT_PAYPAL_CLIENT_ID>
PAYPAL_SECRET=<INSERT_PRIVATE_PAYPAL_SECRET>
DOLAR_CLP_RESPALDO=
API_MAX_BODY_BYTES=16384
API_LOGIN_PER_MINUTE=10
API_IDENTITY_PER_15_MINUTES=10
API_AUX_PER_MINUTE=30
API_PURCHASE_PER_MINUTE=20
API_PUBLIC_PRICE_PER_MINUTE=60
API_EXPORT_PER_MINUTE=4
API_EXPORT_CONCURRENCY=2
API_REPORT_MAX_ROWS=2000
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000
INTERNAL_API_DB_REGULAR_CONNECTIONS=8
INTERNAL_API_DB_SOS_CONNECTIONS=4
INTERNAL_API_TICKETS_PER_15_MINUTES=10

