# EMERGEN internal-api (FastAPI). Copia como .env en esta misma carpeta.
#
# El servicio ya lee el .env de la raíz del monorepo (DB_USER, DB_PASSWORD, DB_NAME, JWT_SECRET),
# igual que el backend NestJS local. Este archivo solo sobrescribe lo que cambia fuera de Docker.

# El .env de la raíz usa db:5432, que solo existe dentro de la red de Docker.
DB_HOST=localhost
DB_PORT=5433

# Puerto del servicio. 3000/3001 (NestJS), 5173-5175 (Vite), 5433 (PostgreSQL) y 5488 (jsReport) ya están en uso.
INTERNAL_API_PORT=8000

# Orígenes permitidos (separados por coma). Vacío = sin CORS.
# Para que web/mobile/desktop llamen directo: http://localhost:5173,http://localhost:5174,http://localhost:5175
# Descomentar únicamente para sobrescribir CORS_ORIGINS. Una asignación vacía desactiva CORS.
# INTERNAL_API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://localhost

# false oculta /docs, /redoc y /openapi.json (recomendado fuera de desarrollo).
INTERNAL_API_DOCS_ENABLED=true
