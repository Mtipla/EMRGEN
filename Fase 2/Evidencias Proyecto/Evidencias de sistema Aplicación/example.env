# ---------- Cifrado de la ficha médica (CA-11.1, AES-256-GCM) ----------
# "id:clave" con 32 bytes en base64; la primera cifra y todas descifran (para rotar,
# agrega la nueva al inicio). Generar una propia por entorno, nunca versionarla:
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Perderla deja ilegibles las fichas guardadas. BD existente: node scripts/cifrar-fichas.cjs
MEDICAL_DATA_KEYS=<INSERT_YOUR_MEDICAL_DATA_KEYS_HERE>

# ---------- 5. mindicador.cl (API pública, sin key) ----------
MINDICADOR_API_URL=https://mindicador.cl/api

