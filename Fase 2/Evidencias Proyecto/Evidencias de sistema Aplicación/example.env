# Copiar a .env en la raíz. Archivo privado, nunca versionar valores reales.
# Docker: db:5432. Desarrollo local: apps/backend/.env.local.example.
DB_HOST=db
DB_PORT=5432
DB_USER=admin_emergen
DB_PASSWORD=<INSERT_YOUR_DATABASE_PASSWORD_HERE>
DB_NAME=EMERGEN_BDD
PORT=3000
HOST=0.0.0.0
EMERGEN_ENVIRONMENT=development
# Docker Compose usa por defecto docker; desarrollo local utiliza local.
# En hosting definir el mismo ID explícito en las dos APIs y VITE_DEPLOYMENT_ID.

# Un solo secreto JWT, compartido por NestJS y FastAPI.
JWT_SECRET=<INSERT_YOUR_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS_HERE>
JWT_SESSION_HOURS=2
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://localhost
# Se reutiliza CORS_ORIGINS si esta variable no está definida.
INTERNAL_API_DOCS_ENABLED=true

# Conservar TODAS las claves que cifraron las fichas existentes al migrar.
# Para una instalación NUEVA: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
MEDICAL_DATA_KEYS=<INSERT_YOUR_MEDICAL_DATA_KEYS_HERE>

# Configurar y vincular en la instancia elegida. No compartir la misma sesión entre procesos.
WHATSAPP_ENABLED=false
WHATSAPP_DEFAULT_COUNTRY_CODE=56
WHATSAPP_SENDER_PHONE=<INSERT_YOUR_WHATSAPP_SENDER_PHONE_HERE>
# En Docker la ruta persistente la fija docker-compose.yml. Ver docs/DESPLIEGUE.md.

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=<INSERT_YOUR_PAYPAL_CLIENT_ID_HERE>
PAYPAL_SECRET=<INSERT_YOUR_PAYPAL_SECRET_HERE>
FIREBASE_PROJECT_ID=<INSERT_YOUR_FIREBASE_PROJECT_ID_HERE>
JSREPORT_URL=http://localhost:5488
JSREPORT_URL_DOCKER=http://host.docker.internal:5488
JSREPORT_USERNAME=
JSREPORT_PASSWORD=
GOOGLE_MAPS_API_KEY=<INSERT_YOUR_GOOGLE_MAPS_SERVER_KEY_HERE>
MINDICADOR_API_URL=https://mindicador.cl/api
DOLAR_CLP_RESPALDO=981

# PÚBLICAS: Vite incorpora estos valores al compilar. Nunca poner secretos VITE_*.
VITE_API_URL=http://localhost:3000
VITE_INTERNAL_API_URL=http://localhost:8000
VITE_DEPLOYMENT_ID=local
VITE_FIREBASE_API_KEY=<INSERT_YOUR_PUBLIC_FIREBASE_API_KEY_HERE>
VITE_FIREBASE_AUTH_DOMAIN=<INSERT_YOUR_FIREBASE_AUTH_DOMAIN_HERE>
VITE_FIREBASE_PROJECT_ID=<INSERT_YOUR_FIREBASE_PROJECT_ID_HERE>
VITE_FIREBASE_STORAGE_BUCKET=<INSERT_YOUR_FIREBASE_STORAGE_BUCKET_HERE>
VITE_FIREBASE_MESSAGING_SENDER_ID=<INSERT_YOUR_FIREBASE_MESSAGING_SENDER_ID_HERE>
VITE_FIREBASE_APP_ID=<INSERT_YOUR_FIREBASE_APP_ID_HERE>
VITE_FIREBASE_MEASUREMENT_ID=
VITE_PAYPAL_CLIENT_ID=<INSERT_YOUR_PAYPAL_CLIENT_ID_HERE>
VITE_GOOGLE_MAPS_API_KEY=<INSERT_YOUR_PUBLIC_GOOGLE_MAPS_KEY_HERE>
VITE_GOOGLE_MAPS_MAP_ID=
# Ubicación simulada: solo desarrollo; nunca en APK LAN/hosting.
# VITE_SOS_SIMULATED_LOCATION=-33.4378,-70.6504
