{
  "name": "temp-turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "check:environment": "node scripts/check-environment.mjs",
    "test:environment": "node --test scripts/android-lan-env.test.mjs scripts/api-environment.test.mjs scripts/expected-schema.test.cjs",
    "migrate:deployment": "node scripts/migrate-whatsapp.cjs && node scripts/migrate-contactos-antecedentes.cjs && node scripts/migrate-tickets-responsable.cjs",
    "build:hosting": "node scripts/check-environment.mjs --mode production && turbo run build --filter=web --filter=mobile --filter=desktop",
    "backup:db": "node scripts/backup-db.mjs",
    "check:data": "node scripts/check-data-integrity.cjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.11.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "engines": {
    "node": "^24.21.0",
    "npm": "^11.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.19.0",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
