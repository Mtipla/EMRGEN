# Desarrollo fuera de Docker: copiar a apps/backend/.env.local (ignorado).
# Credenciales/JWT/MEDICAL_DATA_KEYS se heredan del .env raíz: no generar otras claves.
DB_HOST=localhost
DB_PORT=5433
HOST=0.0.0.0
PORT=3000
EMERGEN_ENVIRONMENT=development
EMERGEN_DEPLOYMENT_ID=local
WHATSAPP_ENABLED=true
# Configurar el emisor real y vincularlo según docs/WHATSAPP_SOS.md.
WHATSAPP_SENDER_PHONE=<INSERT_YOUR_WHATSAPP_SENDER_PHONE_HERE>
WHATSAPP_AUTH_DIR=auth_info_baileys
