{"nodes": [{"id": "contributing_team_workflow_guide", "label": "Team Workflow Guide (Claude Code + Graphify + Git Flow)", "file_type": "document", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_graphify_tool", "label": "Graphify (graphifyy 0.9.65, pinned)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single pinned Graphify version for the whole team; mismatched versions invalidate the graph cache and produce huge diffs and conflicts."}, {"id": "contributing_claude_code", "label": "Claude Code", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_uv_tool_manager", "label": "uv (Python tool manager)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_main_branch", "label": "main branch (stable, PR-only)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main is reached only via reviewed Pull Request with 1 approval; never direct push or --force."}, {"id": "contributing_graphify_branch", "label": "graphify branch (shared graph data)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify-out/ is only modified and committed on the graphify branch, and the shared graph always represents the state of main, never in-progress individual work."}, {"id": "contributing_individual_branches", "label": "Individual developer branches (alonso / diego / gabriel)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each developer writes only to their own branch; others' work arrives only through main after PR, never by direct merge between individual branches."}, {"id": "contributing_graph_json_merge_driver", "label": "graph.json union merge driver (.gitattributes)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Union-merges two versions of graph.json instead of producing a conflict; graphify-out/** marked linguist-generated to collapse PR diffs."}, {"id": "contributing_graph_update_procedure", "label": "Shared graph update procedure (post-PR, by PR author)", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandatory after every PR merged to main, done the same day by the author of that PR so updates stay ordered and no two people update at once. Code changes use AST-only 'graphify update .' (no LLM, no token cost); document changes need semantic '/graphify . --update' via Claude Code."}, {"id": "contributing_graphify_skip_hook", "label": "GRAPHIFY_SKIP_HOOK environment variable", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disables automatic graph rebuild in Git hooks so graphify-out/ does not change on individual branches."}, {"id": "contributing_machine_local_files", "label": "Machine-local unversioned files (.graphify_python, .graphify_root)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Files containing absolute paths/interpreter locations are not versioned; .graphify_python must be written without BOM because PowerShell 5.1 Out-File/Set-Content add a BOM that breaks the path (WinError 123)."}, {"id": "contributing_merge_not_rebase_policy", "label": "Merge-not-rebase policy", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All published branches use merge, never rebase or push --force, to keep shared history safe."}, {"id": "contributing_conventional_commits", "label": "Conventional Commits message format", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_no_secrets_policy", "label": "No-secrets policy (.env, MySQL, PayPal, Twilio, Google Maps credentials)", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_branch_protection_rules", "label": "GitHub branch protection rules", "file_type": "concept", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contributing_clone_outside_synced_folders", "label": "Clone outside synced folders (OneDrive/Dropbox)", "file_type": "rationale", "source_file": "CONTRIBUTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sync services can lock or corrupt .git/ files (index.lock errors); recommended path C:\\dev\\EMRGEN."}], "edges": [{"source": "contributing_team_workflow_guide", "target": "contributing_graphify_tool", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CONTRIBUTING.md", "source